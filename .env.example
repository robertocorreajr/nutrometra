# ============================================================
# Variáveis de ambiente — copie para .env e preencha
# Em produção, usar GCP Secret Manager
# ============================================================

# PostgreSQL (superuser — usado pelo Docker e Zitadel)
POSTGRES_ROOT_PASSWORD=

# PostgreSQL (aplicação)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutrometra
POSTGRES_USER=nutrometra
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable    # use 'require' em staging/production

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Zitadel
ZITADEL_ISSUER=http://zitadel:8080
ZITADEL_DOMAIN=zitadel
ZITADEL_CLIENT_ID=          # gerado por: make setup-zitadel
ZITADEL_MASTERKEY=          # minimo 32 caracteres
ZITADEL_ADMIN_USERNAME=     # username do admin inicial
ZITADEL_ADMIN_FIRSTNAME=    # opcional, default: Admin
ZITADEL_ADMIN_LASTNAME=     # opcional, default: Nutrometra
ZITADEL_ADMIN_EMAIL=        # email do admin (usado como login)
ZITADEL_ADMIN_PASSWORD=     # senha do admin do Zitadel

# Zitadel SMTP (para envio de emails de verificação, reset de senha, etc.)
ZITADEL_SMTP_HOST=             # ex: smtp.gmail.com
ZITADEL_SMTP_PORT=587          # 587 para STARTTLS, 465 para SSL
ZITADEL_SMTP_USER=             # ex: no-reply@nutrometra.com
ZITADEL_SMTP_PASSWORD=         # senha ou app password
ZITADEL_SMTP_FROM=             # ex: Nutrometra <no-reply@nutrometra.com>
ZITADEL_SMTP_FROM_NAME=Nutrometra
ZITADEL_SMTP_TLS=true          # true para STARTTLS (porta 587)

# API
API_PORT=8081
API_ENV=development
LOG_LEVEL=debug

# Frontend — API
NEXT_PUBLIC_API_URL=http://localhost:8081

# Frontend — Auth (web-professional, porta 3000)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
ZITADEL_CLIENT_SECRET=

# Frontend — Auth (web-patient, porta 3001)
ZITADEL_CLIENT_ID_PATIENT=          # gerado por: make setup-zitadel
ZITADEL_CLIENT_SECRET_PATIENT=

# Frontend — Auth (backoffice, porta 3002)
ZITADEL_CLIENT_ID_BACKOFFICE=       # gerado por: make setup-zitadel
ZITADEL_CLIENT_SECRET_BACKOFFICE=

# Frontend — Feature flags
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_GOOGLE_CALENDAR=true
