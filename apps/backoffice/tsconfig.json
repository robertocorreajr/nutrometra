{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nutrometra/ui": ["../../packages/ui/src"],
      "@nutrometra/api-client": ["../../packages/api-client/src"],
      "@nutrometra/api-client/hooks": ["../../packages/api-client/src/hooks/index.ts"],
      "@nutrometra/api-client/types": ["../../packages/api-client/src/types/index.ts"],
      "@nutrometra/auth": ["../../packages/auth/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
